{
  "manifest_version": 1,
  "id": "presentations",
  "name": "Presentations",
  "version": "0.14.0",
  "description": "HTML presentations created by agents (reports, diagrams, code reviews, images) \u2014 top-bar gallery nav + a window that renders each presentation. Replaces the monolith's /ws/presentations feature and the aw-frontend static PresentationNav. Diff viewing lives in the separate aw-app-diff-tool.",
  "tier": "inprocess",
  "requires_ui_refresh": true,
  "publisher": "TekFlox",
  "resource_estimate": {
    "cpu": "low",
    "memory": "low",
    "disk": "low"
  },
  "runtime": {
    "python": ">=3.11",
    "entrypoint": "presentations_app.plugin:PresentationsAppPlugin",
    "pip_requires": [
      "playwright>=1.40"
    ]
  },
  "permissions": [
    "routes:register",
    "db:own-tables",
    "ui:code",
    "ui:slots:core.nav"
  ],
  "contributes": {
    "routes": [
      {
        "prefix": "/api/apps/presentations"
      }
    ],
    "windows": [
      {
        "id": "presentations.viewer",
        "title": "Presentation",
        "icon": "layout",
        "body": {
          "type": "component"
        }
      }
    ],
    "frontend": {
      "mode": "component",
      "bundle": "ui/dist/presentations-ui.mjs",
      "slots": [
        "core.nav",
        "core.window.body:presentations.viewer"
      ]
    },
    "skills": [
      {
        "id": "aw-presentation",
        "path": "skills/aw-presentation/SKILL.md",
        "description": "How to create visual presentations from an agent (create_presentation, commented_file, show_image, export_presentation_to_image, share_presentation) \u2014 analysis reports, diagrams, code reviews, images. Diffs are handled by aw-diff-tool's own skill."
      }
    ],
    "mcp": {
      "reload_on_save": true,
      "provides": [
        "create_presentation",
        "update_presentation",
        "delete_presentation",
        "list_presentations",
        "show_image",
        "export_presentation_to_image",
        "commented_file",
        "share_presentation"
      ]
    }
  },
  "config_schema": {
    "type": "object",
    "properties": {},
    "required": []
  },
  "dependencies": {},
  "migrations": {}
}
