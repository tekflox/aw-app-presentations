{
  "manifest_version": 1,
  "id": "presentations",
  "name": "Presentations",
  "version": "0.4.0",
  "description": "HTML presentations created by agents (diffs, reports, dashboards) \u2014 top-bar gallery nav + a window that renders each presentation. Replaces the monolith's /ws/presentations feature and the aw-frontend static PresentationNav.",
  "tier": "inprocess",
  "requires_ui_refresh": true,
  "publisher": "TekFlox",
  "resource_estimate": {
    "cpu": "low",
    "memory": "low",
    "disk": "low"
  },
  "runtime": {
    "python": ">=3.11",
    "entrypoint": "presentations_app.plugin:PresentationsAppPlugin",
    "pip_requires": []
  },
  "permissions": [
    "routes:register",
    "db:own-tables",
    "ui:code",
    "ui:slots:core.nav"
  ],
  "contributes": {
    "routes": [
      {
        "prefix": "/api/apps/presentations"
      }
    ],
    "windows": [
      {
        "id": "presentations.viewer",
        "title": "Presentation",
        "icon": "layout",
        "body": {
          "type": "component"
        }
      }
    ],
    "frontend": {
      "mode": "component",
      "bundle": "ui/dist/presentations-ui.mjs",
      "slots": [
        "core.nav",
        "core.window.body:presentations.viewer"
      ]
    }
  },
  "config_schema": {
    "type": "object",
    "properties": {},
    "required": []
  },
  "dependencies": {},
  "migrations": {}
}
